{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quartz",
  "scopeName": "source.quartz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#libraries" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.quartz",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.quartz",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.quartz",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.quartz",
          "match": "\\\\[ntr\"\\\\0]"
        },
        {
          "name": "constant.character.escape.quartz",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.embedded.quartz",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.quartz" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.quartz" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#libraries" },
            { "include": "#builtins" },
            { "include": "#calls" },
            { "include": "#operators" }
          ]
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.quartz" },
            "2": { "name": "entity.name.function.quartz" }
          }
        },
        {
          "match": "\\b(struct|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.quartz" },
            "2": { "name": "entity.name.type.quartz" }
          }
        },
        {
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.quartz" },
            "2": { "name": "variable.other.quartz" }
          }
        },
        {
          "match": "\\b(import)\\b",
          "name": "keyword.control.import.quartz"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quartz",
          "match": "\\b(if|else|while|for|in|step|break|continue|return|match)\\b"
        },
        {
          "name": "keyword.declaration.quartz",
          "match": "\\b(let|const|fn|struct|impl|pub|import)\\b"
        },
        {
          "name": "variable.language.self.quartz",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.quartz",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "comment": "Reserved but not implemented - flagged so it is obvious the compiler will refuse them.",
          "name": "invalid.illegal.reserved.quartz",
          "match": "\\b(defer|own|unsafe)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.quartz",
          "match": "\\b(int|float|str|bool)\\b"
        },
        {
          "comment": "A capitalised name after a colon, arrow or in a literal is a struct type.",
          "name": "entity.name.type.quartz",
          "match": "(?<=:|->|\\[\\]|\\?)\\s*([A-Z][A-Za-z0-9_]*)"
        },
        {
          "comment": "The ! and ? that make a type fallible or nullable.",
          "name": "keyword.operator.type.quartz",
          "match": "(?<=[A-Za-z0-9_\\]\\}])!(?=\\s*[=\\{\\)\\n]|$)"
        }
      ]
    },

    "constants": {
      "name": "constant.language.quartz",
      "match": "\\b(E|INF|NAN|PI)\\b"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.quartz",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.quartz",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "libraries": {
      "comment": "Dotted library paths: os.file.read, http.get, json.decode.",
      "match": "\\b(http|json|mem|net|os|time)\\b((?:\\.[A-Za-z_][A-Za-z0-9_]*)+)",
      "captures": {
        "1": { "name": "support.class.library.quartz" },
        "2": { "name": "support.function.library.quartz" }
      }
    },

    "builtins": {
      "name": "support.function.builtin.quartz",
      "match": "\\b(abs|acos|asin|atan2|atan|beep|cbrt|ceil|charAt|chars|clamp|clear|contains|cos|count|divf|endsWith|errorOf|exit|exp|fail|failed|find|first|float|floor|has|hideConsole|hypot|indexOf|input|insert|int|isFloat|isInt|isNan|isOk|isWin11|join|keys|last|len|lines|log10|log2|log|lower|max|messageBox|min|mod|must|openWindow|padLeft|padRight|pause|pop|pow|print|push|randomInt|random|remove|removeAt|repeat|replace|reverse|round|setTitle|sign|sin|sleep|slice|sort|split|sqrt|startsWith|str|substr|sum|tan|toFloat|toInt|trim|trunc|upper|valueOr|values|winBuild|write)\\b(?=\\s*\\()"
    },

    "calls": {
      "comment": "Anything else called like a function.",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.quartz" } }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.quartz",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.arrow.quartz",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.quartz",
          "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)?="
        },
        {
          "name": "keyword.operator.comparison.quartz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.quartz",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.quartz",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.quartz",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.try.quartz",
          "match": "\\?"
        }
      ]
    }
  }
}
