// logic.vl -- loops, math, and strings

fn isPrime(n: int) -> bool {
    if n < 2 { return false }
    for d in 2..=int(sqrt(float(n))) {
        if n % d == 0 { return false }
    }
    return true
}

fn factorial(n: int) -> int {
    let acc = 1
    for i in 2..=n { acc *= i }
    return acc
}

fn bar(value: int, width: int) -> str {
    let filled = round(divf(value * width, 100))
    return repeat("#", filled) + repeat(".", width - filled)
}

print("== ranges ==")
for i in 1..=5 { write("{i} ") }
print("")
for i in 10..0 step -2 { write("{i} ") }
print("")

print("")
print("== primes under 60 ==")
for n in 2..60 {
    if isPrime(n) { write("{n} ") }
}
print("")

print("")
print("== factorials ==")
for n in 1..=10 {
    print("{padLeft(str(n), 2)}! = {padLeft(str(factorial(n)), 10)}")
}

print("")
print("== math ==")
print("sqrt(2)     {sqrt(2)}")
print("PI          {PI}")
print("hypot(3,4)  {hypot(3, 4)}")
print("7/2         {7 / 2} (int)   {divf(7, 2)} (float)")

print("")
print("== a chart ==")
for pct in 0..=100 step 20 {
    print("{padLeft(str(pct), 3)}% |{bar(pct, 25)}|")
}

print("")
print("== collatz, with break ==")
let n = 27
let steps = 0
while true {
    if n == 1 { break }
    if n % 2 == 0 { n /= 2 } else { n = 3 * n + 1 }
    steps += 1
}
print("27 reaches 1 in {steps} steps")
