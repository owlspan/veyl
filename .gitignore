qzc

# programs built from examples
examples/*.exe
examples/demo
examples/interactive
examples/hello

# A verified snapshot kept on disk as a fallback, refreshed by hand
# after each milestone. Deliberately untracked: git already has every
# version tagged, and keeping a second copy in history would double the
# repo for no gain. Being ignored is also what lets it survive a
# `git reset --hard`, which is exactly when it is wanted.
Working version/

# Installer build output: a staged copy of the Go toolchain (~177 MB)
# and the setup executable built from it. Both are reproducible from
# installer\build.ps1, and neither belongs in git.
dist/

# editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
