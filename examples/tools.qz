// tools.qz -- a tour of the dotted libraries.
//
// Everything here is a builtin. There are no imports in Quartz.

print("== this machine ==")
print("{os.name()}/{os.arch()}, {os.cpus()} cpus, host {os.hostname()}")
print("local address {net.localIP()}")
print("time now {time.stamp()} ({time.weekday()})")
print("")

print("== a scratch file ==")
const path = "tools_scratch.txt"

os.file.write(path, "alpha\n")
os.file.append(path, "beta\n")
os.file.append(path, "gamma\n")

// Reading can fail, so these hand back a result. must() takes the
// value or stops with the reason — fine here, where we just wrote it.
let found = must(os.file.lines(path))
print("wrote {len(found)} lines, {must(os.file.size(path))} bytes")
for i, line in found {
    print("  {i + 1}. {upper(line)}")
}

// The same read, handled rather than assumed.
let absent = os.file.read("no_such_file_here.txt")
if failed(absent) {
    print("as expected: {errorOf(absent)}")
}
os.file.delete(path)
print("cleaned up: exists = {os.file.exists(path)}")
print("")

print("== word counting ==")
const passage = "the quick brown fox jumps over the lazy dog the fox"
let counts: {str: int} = {}
for word in split(passage, " ") {
    counts[word] += 1
}

// Iteration is sorted, so this prints the same order every run.
for word, n in counts {
    if n > 1 {
        print("  {padRight(word, 8)} {repeat("*", n)} {n}")
    }
}
print("{len(keys(counts))} distinct words")
print("")

print("== open ports on this machine ==")
let started = time.millis()
let open = net.scan("127.0.0.1", 1, 1024, 200)
print("scanned 1024 ports in {time.millis() - started} ms")
if len(open) == 0 {
    print("  nothing listening below 1024")
} else {
    print("  open: {open}")
}
print("")

print("== memory ==")
let before = mem.used()
let big: []int = []
for i in 0..100000 {
    push(big, i * i)
}
print("held {len(big)} numbers, using {(mem.used() - before) / 1024} KB more")
print("sum of the first ten: {sum(slice(big, 0, 10))}")
mem.collect()
print("collector has run {mem.collections()} times")
