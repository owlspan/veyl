# compiler binary
/veylasm
/veylasm.exe

# `go build ./...` drops this next to the package it built, named
# after the directory rather than the module. Only the .exe: a bare
# /compiler would match the compiler/ directory itself and silently
# stop tracking every new file in it.
/compiler.exe

# programs built from examples
examples/*.exe
examples/**/*.exe
examples/*.s
examples/*.o

# leftover build artifacts
*~

# Installer build output: the setup executable, reproducible from
# installer\build.ps1.
/dist/
