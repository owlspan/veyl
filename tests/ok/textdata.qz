// ---- raw strings ----
//
// Backticks: no escapes, no interpolation, and they span lines. For
// text already full of backslashes and braces — a pattern, a block of
// CSV — quoting it twice is what goes wrong.

const log = `2024-01-15 ERROR disk full
2024-01-16 WARN low memory
2024-01-17 ERROR network down`

print("lines in the log {len(lines(log))}")
print("backslash is literal {len(`a\nb`)} vs escaped {len("a\nb")}")
print("braces are literal {`{not interpolated}`}")

// ---- regular expressions ----
//
// Patterns belong in raw strings. In an ordinary string `{4}` is an
// interpolation, so a quantifier would have to be written {{4}}.

const DATE = `\d{4}-\d{2}-\d{2}`
const PARTS = `(\d+)-(\d+)-(\d+)`

print("has errors {re.matches("ERROR", log)}")
print("first date {re.find(DATE, log)}")
print("all dates {re.findAll(DATE, log)}")
print("error count {re.count("ERROR", log)}")

// Capture groups come back without the whole match.
print("groups {re.groups(PARTS, log)}")
print("no match gives nothing {re.groups(`(zzz)`, log)}")

print("replaced {re.replace("ERROR", "x ERROR y", "PROBLEM")}")
print("split {re.split(`\s*,\s*`, "a , b,c ,  d")}")

// A pattern from outside the program can be checked first.
print("valid {re.valid(`^[a-z]+$`)} invalid {re.valid(`[unclosed`)}")

// Escaping, for matching text literally.
let dotted = "a.b.c"
let literalDot = re.escape(".")
print("escaped {re.count(literalDot, dotted)} unescaped {re.count(".", dotted)}")

// A pattern used in a loop is compiled once, not every time.
let total = 0
for i in 0..100 {
    if re.matches("^ERROR", "ERROR {i}") {
        total += 1
    }
}
print("loop matched {total}")

// ---- hashes and encodings ----

// Known values, so a change in behaviour is caught rather than guessed.
print("md5 {hash.md5("abc")}")
print("sha1 {hash.sha1("abc")}")
print("sha256 {hash.sha256("abc")}")
print("sha512 starts {substr(hash.sha512("abc"), 0, 16)}")
print("crc32 {hash.crc32("abc")}")
print("empty sha256 starts {substr(hash.sha256(""), 0, 16)}")

// Encodings round-trip.
const secret = "hello, world"
let encoded = hash.base64(secret)
print("base64 {encoded} back {must(hash.fromBase64(encoded))}")

let hexed = hash.hex(secret)
print("hex {hexed} back {must(hash.fromHex(hexed))}")

print("bad base64 fails {isOk(hash.fromBase64("not!valid!"))}")
print("bad hex fails {isOk(hash.fromHex("zzzz"))}")

// Hashing a file, streamed rather than read whole.
os.file.write("qz_hash_probe.txt", "abc")
let fileSum = must(hash.file("qz_hash_probe.txt"))
print("file matches string {fileSum == hash.sha256("abc")}")
print("missing file fails {isOk(hash.file("no_such_file.txt"))}")
os.file.delete("qz_hash_probe.txt")

// ---- csv ----

const table = `name,age,city
ada,36,London
alan,41,Wilmslow`

let rows = must(csv.parse(table))
print("rows {len(rows)} header {rows[0]}")
print("second row {rows[1]} age {rows[1][1]}")

// Quoting and embedded commas survive a round trip.
let tricky: [][]str = [
    ["plain", "with,comma"],
    [`with "quotes"`, "with\nnewline"]
]
let written = csv.write(tricky)
let readBack = must(csv.parse(written))
print("round trip {readBack == tricky}")

// Ragged rows are read rather than refused.
const ragged = `a,b,c
d,e`
print("ragged {must(csv.parse(ragged))}")

// Reading and writing a file.
csv.save("qz_table.csv", tricky)
let fromDisk = must(csv.read("qz_table.csv"))
print("saved and read {fromDisk == tricky}")
print("missing csv fails {isOk(csv.read("no_such.csv"))}")
os.file.delete("qz_table.csv")
