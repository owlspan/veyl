// url, bits and args.
//
// zip is exercised separately, since it writes files.

let u = "https://api.example.com:8443/v2/items?limit=10&sort=name#top"
print(must(url.scheme(u)))
print(must(url.host(u)))
print(must(url.port(u)))
print(must(url.path(u)))
print(must(url.fragment(u)))

let q = must(url.query(u))
print(q["limit"])
print(q["sort"])

// Parameters come out sorted, so the same map always builds the same
// URL. That matters for caching and for tests like this one.
print(url.build("https://x.dev/s", {"q": "quartz", "page": "2"}))
print(url.build("https://x.dev/s?a=1", {"b": "2"}))
print(url.build("https://x.dev/s", {}))
print(must(url.join("https://x.dev/a/b", "../c")))
print(must(url.join("https://x.dev/a/b", "/root")))

// A URL with no port or fragment gives empty strings, not failures.
let bare = "http://example.com/"
print(must(url.port(bare)) == "")
print(must(url.fragment(bare)) == "")

print(bits.count(255))
print(bits.count(0))
print(bits.length(255))
print(bits.trailing(8))
print(bits.leading(1) > 0)
print(bits.rotate(1, 1))
print(bits.toBase(255, 16))
print(bits.toBase(5, 2))
print(bits.toBase(255, 99))
print(must(bits.fromBase("ff", 16)))
print(must(bits.fromBase("1010", 2)))
print(isOk(bits.fromBase("zz", 16)))
print(errorOf(bits.fromBase("x", 40)))

// No flags were passed, so everything falls back.
print(args.flag("verbose"))
print(args.value("out", "default.txt"))
print(args.rest())
