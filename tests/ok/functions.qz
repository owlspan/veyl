fn half(x: float) -> float {
    return x / 2.0
}

fn describe(n: int) -> str {
    if n > 10 {
        return "big"
    }
    return "small"
}

fn greet(name: str) {
    print("hello, {name}")
}

// Declaration order does not matter, and recursion works.
fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

print("{half(9.0)} {describe(20)} {describe(2)}")
greet("quartz")
print("fib(20) = {fib(20)}")

// A float parameter accepts an integer literal.
print("{half(9)}")
